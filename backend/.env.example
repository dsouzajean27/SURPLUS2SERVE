# Copy this file to .env and fill in your own values before running the server.
# (.env holds secrets - never commit it to GitHub.)

# MySQL connection details
DB_HOST=localhost
DB_PORT=3306
DB_USER=s2s_user
DB_PASSWORD=change-me
DB_NAME=surplus2serve

# Secret key used to sign JWT tokens - use a long random string
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Needed to register an *admin* account on the sign-up form
ADMIN_SIGNUP_CODE=S2S-ADMIN-2026

# Allowed frontend origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: e-mail notifications (leave SMTP_HOST empty to disable)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
